; ---- OP03 OP03-POCKET_002 (复用立铣刀) ----
300  ; BREAKPOINT: CP003
M08
; 铣削: POCKET_002
S1850 M03
; 参数来自数据库: 材料=steel, 直径=10.0mm
; 刀轨引擎未生成环切 [E4001] [刀轨规划] 挖槽区域过窄（内切尺寸 < 刀具直径 10.00mm），无法环切。建议操作：更换小直径刀具，或对该特征改用钻削/电加工工艺。；以下为模板走线
; 启用刀具半径补偿: G41
G00 Z80.000
G00 X20.000 Y0.000
G01 Z45.000 F275.0
G41 D10
L  X+40.000 Y+0.000 Z+45.000 R0 F275.000
L  X+40.000 Y+6.000 Z+45.000 R0 F275.000
G40
; 取消刀具半径补偿
G00 Z80.000
M09

; ---- OP04 OP04-HOLE_001 - 钻沉头孔 ----
5  TOOL CALL 2 Z S1000
6  L  Z+80.000 R0 FMAX
7  L  X+0 Y+0 R0 FMAX
400  ; BREAKPOINT: CP004
M08
; 钻孔: HOLE_001
S805 M03
; 进给: 0.05-0.15 mm/rev, 切速: 80-200 m/min
; 参数来自数据库: 材料=steel, 直径=10.0mm
8  CYCL DEF 203 UNIVERSAL DRILLING
9     Q200=80.000  ;SET-UP CLEARANCE
10     Q201=-8.000  ;DEPTH
11     Q206=3000.000  ;FEED RATE
12     Q202=5.000  ;PLUNGING DEPTH
13     Q203=0.000  ;SURFACE COORDINATE
14     Q204=80.000  ;2ND SET-UP CLEARANCE
15  CYCL CALL
G80
G00 Z80.000
M09

; 程序结束

16  M09
17  M05
18  L  Z+80.000 R0 FMAX
19  L  X+0 Y+0 R0 FMAX
20  M30
21  END PGM 1000 MM