# ============================================================
# 灵境制造 AI 模型配置 - 国内版
# ============================================================
# 说明：
#   1. 本地模型：使用 ModelScope 从魔搭社区下载，避免访问境外 HuggingFace
#   2. 云端 API：支持阿里百炼、DeepSeek、智谱等国内服务商
#   3. 优先级：本地模型 > 云端 API（可通过 AI_MODE 切换）
# ============================================================

# AI 模式选择：local（本地） / cloud（云端） / hybrid（混合）
AI_MODE=local

# ============================================================
# 本地模型配置（Ollama / vLLM / Xinference）
# ============================================================
# Ollama 服务地址（国内需自建或使用 ModelScope 下载模型）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# 如果使用 vLLM 或 Xinference，修改为对应地址
# VLLM_BASE_URL=http://localhost:8000/v1
# XINFERENCE_BASE_URL=http://localhost:9997/v1

# ============================================================
# 云端 API 配置（国内服务商）
# ============================================================

# 阿里百炼（推荐）
# 申请地址：https://bailian.console.aliyun.com/
CLOUD_PROVIDER=aliyun
# P2-12 修复：统一占位符格式为 PLEASE_CHANGE_ME_xxx，与 .env.example 保持一致
CLOUD_API_KEY=PLEASE_CHANGE_ME_aliyun_api_key
CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_MODEL=qwen-plus

# DeepSeek（性价比高）
# 申请地址：https://platform.deepseek.com/
# CLOUD_PROVIDER=deepseek
# CLOUD_API_KEY=PLEASE_CHANGE_ME_deepseek_api_key
# CLOUD_BASE_URL=https://api.deepseek.com/v1
# CLOUD_MODEL=deepseek-coder

# 智谱 AI（GLM 系列）
# 申请地址：https://open.bigmodel.cn/
# CLOUD_PROVIDER=zhipu
# CLOUD_API_KEY=PLEASE_CHANGE_ME_zhipu_api_key
# CLOUD_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CLOUD_MODEL=glm-4

# 百度千帆
# 申请地址：https://cloud.baidu.com/product/qianfan
# CLOUD_PROVIDER=baidu
# CLOUD_API_KEY=PLEASE_CHANGE_ME_baidu_api_key
# CLOUD_BASE_URL=https://aip.baidubce.com/rpc/2.0/ai_custom/v1/wenxinworkshop
# CLOUD_MODEL=ernie-4.0

# ============================================================
# 模型下载（本地部署必需）
# ============================================================
# 使用 ModelScope 下载模型（国内镜像）
# pip install modelscope
# python scripts/download_models.py --all

# 模型缓存目录
MODEL_CACHE_DIR=./models
