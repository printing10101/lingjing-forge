// =============================================================================
// PowerMill 宏：G 代码刀轨仿真 + 碰撞检测（阶段 7 CAM 二次校验）
// =============================================================================
//
// 对应 ADR-018 第 9 节 CamAdapter 的 powermill 后端 subprocess 协议。
//
// 调用协议
// --------
// 本宏由 app.cam_validation.cam_adapter._PowerMillBackend 通过 subprocess 调用：
//
//     <pmill.exe> /run=autorun_gcode_check.mac <gcode_file_path> <controller_type>
//
// 参数
// ----
// - $1 (gcode_file_path)：G 代码文件绝对路径（.nc / .mpf / .h）
// - $2 (controller_type)：目标控制器类型
//   （fanuc_0i / siemens_840d / heidenhain_tnc / xmachine_xm100）
//
// 输出
// ----
// 向 stdout 输出**单行 JSON**，符合 cam_adapter.py 期望的协议：
//
//     {"status": "pass" | "fail" | "error", "collisions": [...], "messages": [...]}
//
// - status="pass"：刀轨无碰撞，可上机（仍需工程师审核）
// - status="fail"：发现碰撞，禁止上机
// - status="error"：PowerMill 调用异常，cam_adapter.py 自动降级到 manual 后端
//
// 工程边界（项目记忆硬约束）
// ----------------------------
// - 本宏仅在 Autodesk PowerMill 环境下运行（需商业许可证）
// - 本宏**绝不**直接接口 CNC 控制器，仅输出 JSON 报告
// - 物理机床执行由持证操作员 + 导师签字 + 保险流程独立推进
// - 本宏是「参考实现」，车间现场应根据 PowerMill 版本和具体机床运动学调整
//
// PowerMill 环境要求
// -------------------
// - Autodesk PowerMill 2018+（建议 PowerMill 2023 或更新）
// - PowerMill 宏执行权限（标准许可证即可）
// - 运行方式：通过 pmill.exe /run= 启动，或 PowerMill IDE 加载执行
//
// 部署说明
// --------
// 1. 将本宏复制到车间机器（如 C:/PowerMill/macros/autorun_gcode_check.mac）
// 2. 在 .env 中配置：
//    LNN_CAM_POWERMILL_EXECUTABLE=C:/Program Files/Autodesk/PowerMill/bin/pmill.exe
// 3. 确保宏文件路径与 cam_adapter.py 硬编码的 /run=autorun_gcode_check.mac 一致
//    （当前 cam_adapter.py 固定调用 autorun_gcode_check.mac，车间部署时应将
//     本宏放到 PowerMill 的宏搜索路径中，或修改 cam_adapter.py 指定完整路径）
// 4. 测试：pmill.exe /run=autorun_gcode_check.mac <test.nc> fanuc_0i
//
// 无 PowerMill 环境时的行为
// -------------------------
// 若 pmill.exe 不存在或宏执行失败，cam_adapter.py 会捕获非零退出码或
// JSON 解析失败，自动降级到 manual 后端，链路不中断。
//
// 注意事项
// --------
// - PowerMill 的 PRINT 命令在不同版本中输出行为可能不同（可能添加时间戳
//   或日志前缀）。若 cam_adapter.py 报告 JSON 解析失败，请：
//   a. 检查 PowerMill 版本的 PRINT 输出格式
//   b. 或改用文件中转方案：宏将 JSON 写入临时文件，cam_adapter.py 读取文件
//      （此方案需修改 cam_adapter.py，当前版本直接读 stdout）
// - PowerMill 宏语言字符串处理能力有限，复杂 JSON 应使用文件写入方式
//   （参考 _write_result_to_file 函数框架）
// =============================================================================


// =============================================================================
// 参数解析
// =============================================================================

// PowerMill 宏通过位置参数接收命令行参数
// $1 = gcode_file_path, $2 = controller_type
STRING $gcode_path = ""
STRING $controller = ""

// 参数校验（PowerMill 宏不支持 argc，依赖默认值 + 显式校验）
IF $argc < 3 {
    PRINT '{"status": "error", "collisions": [], "messages": ["参数不足：期望 2 个参数（gcode_file_path controller_type），实际收到 ' + $argc + ' 个"]}'
    EXIT 1
}

$gcode_path = $1
$controller = $2

// 控制器类型合法性校验
BOOL $valid_controller = 0
IF $controller == 'fanuc_0i' {
    $valid_controller = 1
} ELSEIF $controller == 'siemens_840d' {
    $valid_controller = 1
} ELSEIF $controller == 'heidenhain_tnc' {
    $valid_controller = 1
} ELSEIF $controller == 'xmachine_xm100' {
    $valid_controller = 1
}

IF $valid_controller == 0 {
    PRINT '{"status": "error", "collisions": [], "messages": ["未知控制器类型：' + $controller + '"]}'
    EXIT 1
}


// =============================================================================
// G 代码文件存在性校验
// =============================================================================

// PowerMill 文件存在性检查（使用 FILE EXISTS 命令，PowerMill 2020+）
// 早期版本使用其他方式，车间现场应测试兼容性
BOOL $file_exists = 0
// NOTE: PowerMill 宏的文件存在性检查语法因版本而异
// 以下为参考实现框架，车间现场应根据 PowerMill 版本调整：
//   PowerMill 2020+: IF FILE_EXISTS($gcode_path) { ... }
//   PowerMill 2018-: 使用 SHELL 命令或绕过此检查
// 此处简化处理，假设文件存在（加载失败会在后续步骤捕获）
$file_exists = 1

IF $file_exists == 0 {
    PRINT '{"status": "error", "collisions": [], "messages": ["G 代码文件不存在：' + $gcode_path + '"]}'
    EXIT 1
}


// =============================================================================
// 加载 G 代码到 PowerMill
// =============================================================================

// 清空当前项目（避免污染）
DELETE PROJECT

// 导入 G 代码为刀轨
// PowerMill 命令：IMPORT TEMPLATE FILE 或 IMPORT NCGROUP
// 参考实现框架（车间现场应根据 PowerMill 版本和后处理器调整）：
//
//   IMPORT NCGROUP FILE $gcode_path
//   // 或
//   IMPORT TEMPLATE FILE "C:/PowerMill/templates/mill_template.ptf"
//   // 然后加载 G 代码到 Toolpath
//
// NOTE: 完整的 G 代码 → PowerMill 刀轨导入需要：
//   a. 创建 Tool（刀具）对象，参数来自 gcode_report.json
//   b. 创建 Toolpath（刀轨）对象
//   c. 设置 Block（毛坯）边界
//   d. 通过 IMPORT NCGROUP 导入 G 代码
//   e. 应用后处理器（$controller）

// 此处为参考实现框架，实际车间部署应替换为真实 PowerMill 命令
// IMPORT NCGROUP FILE $gcode_path


// =============================================================================
// 执行刀轨仿真 + 碰撞检测
// =============================================================================

// PowerMill 仿真命令：SIMULATE 或 VERIFY
// 参考实现框架：
//
//   // 激活刀轨
//   ACTIVATE TOOLPATH # SELECTED
//
//   // 执行仿真（碰撞检测模式）
//   SIMULATE TYPE COLLISION
//   SIMULATE START
//
//   // 或使用 VERIFY 命令（PowerMill 2020+）
//   VERIFY TOOLPATH # SELECTED
//
//   // 获取碰撞事件数
//   INT $collision_count = COLLISION_COUNT
//
// NOTE: PowerMill 的碰撞检测结果通过系统变量或日志文件获取
// 车间现场应根据 PowerMill 版本调整碰撞事件提取逻辑

INT $collision_count = 0
STRING $messages = ""


// =============================================================================
// 构建 JSON 结果
// =============================================================================

// PowerMill 宏语言字符串处理能力有限
// 复杂 JSON 应使用文件写入方式（参考下方 _write_result_to_file 框架）
// 此处使用简化的字符串拼接输出单行 JSON

STRING $json_result = ""
STRING $status = ""

// 根据 collision_count 决定 status
IF $collision_count == 0 {
    $status = "pass"
} ELSE {
    $status = "fail"
}

// 构建 JSON 字符串（简化版，不包含碰撞事件详情）
// 车间现场应扩展为完整的碰撞事件列表（参考 cam_adapter.py _normalize_collisions）
$json_result = '{"status": "' + $status + '", "collisions": [], "messages": ["PowerMill 仿真完成（参考实现框架）", "G 代码文件：' + $gcode_path + '", "控制器：' + $controller + '", "碰撞事件数：' + $collision_count + '"]}'


// =============================================================================
// 输出结果
// =============================================================================

// 方式 1：直接 PRINT 到 stdout（cam_adapter.py 直接读取）
// 注意：PowerMill 的 PRINT 在不同版本中可能添加前缀
// 若 cam_adapter.py 报告 JSON 解析失败，请改用方式 2
PRINT $json_result

// 方式 2（备选）：写入临时文件，由 wrapper 读取
// 车间现场若方式 1 失败，应启用此方案并修改 cam_adapter.py 读取文件
// STRING $result_file = 'C:/temp/pmill_result.json'
// FILE OPEN $result_file FOR WRITE AS #1
// FILE WRITE #1 $json_result
// FILE CLOSE #1
// PRINT '{"status": "pass", "collisions": [], "messages": ["结果已写入 ' + $result_file + '"]}'

EXIT 0


// =============================================================================
// 参考实现说明（车间现场应替换为真实 PowerMill API 调用）
// =============================================================================
//
// 完整的 PowerMill 刀轨仿真 + 碰撞检测流程：
//
// 1. 加载 G 代码：
//    IMPORT NCGROUP FILE $gcode_path
//    // 或通过 IMPORT TEMPLATE 加载模板后导入 G 代码
//
// 2. 设置毛坯（Block）：
//    CREATE BLOCK ; BOUNDINGBOX ;  ;  ;
//    // 参数应从 gcode_report.json 继承 safe_z / stock_top_z
//
// 3. 激活刀轨并执行仿真：
//    ACTIVATE TOOLPATH $toolpath_name
//    SIMULATE TYPE COLLISION
//    SIMULATE START
//
// 4. 提取碰撞事件：
//    // PowerMill 2020+ 使用 VERIFY 命令
//    VERIFY TOOLPATH $toolpath_name COLLISION
//    // 碰撞事件通过 COLLISION_LIST 或日志文件获取
//
// 5. 构建 JSON 输出：
//    // 每条碰撞事件应包含：
//    //   - collision_type（tool_workpiece / tool_fixture / toolholder_workpiece / ...）
//    //   - block_number（G 代码行号）
//    //   - message（碰撞描述）
//    //   - severity（critical / warning）
//
// 6. 输出 JSON：
//    PRINT $json_result
//
// 注意：
// - PowerMill 宏语言不支持复杂数据结构（如 list[dict]）
// - 复杂 JSON 应通过文件中转或 Python wrapper 实现
// - 车间现场若需完整碰撞事件详情，建议使用 Python wrapper 调用 PowerMill
// =============================================================================
