{
  "name": "lingjing-v4",
  "version": "2.8.0",
  "description": "灵境制造 V4 - AI驱动的3D建模与工艺规划系统",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "runtime:build": "python python/scripts/build_desktop_runtime.py",
    "app:build": "npm run runtime:build && npm run tauri:build",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=junit-frontend.xml --coverage.reporter=json --coverage.reporter=text --coverage.reporter=html --coverage.reportsDirectory=coverage",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/**/*.{ts,vue}",
    "format": "prettier --write src/**/*.{ts,vue,css}",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@tauri-apps/api": "^2.10.1",
    "axios": "^1.6.2",
    "echarts": "^5.5.0",
    "element-plus": "^2.4.4",
    "pinia": "^2.1.7",
    "three": "^0.170.0",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "happy-dom": "^12.10.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sass": "^1.69.5",
    "terser": "^5.46.2",
    "typescript": "^5.3.2",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ],
    "python/app/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ],
    "src-tauri/**/*.rs": [
      "cargo fmt --manifest-path src-tauri/Cargo.toml --"
    ]
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printing10101/Virtual-Realm-Manufacturing.git"
  },
  "keywords": [
    "manufacturing",
    "cnc",
    "ai",
    "liquid-neural-network",
    "lnn",
    "ltc",
    "chatter-prediction",
    "tool-wear",
    "rag",
    "knowledge-graph",
    "ollama",
    "tauri",
    "vue3",
    "fastapi",
    "pytorch",
    "cad",
    "cam",
    "nc-code",
    "postprocessor",
    "mtconnect",
    "digital-manufacturing",
    "industry-4",
    "desktop-app",
    "data-sovereignty"
  ],
  "author": "灵境制造团队",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/printing10101/Virtual-Realm-Manufacturing/issues"
  },
  "homepage": "https://github.com/printing10101/Virtual-Realm-Manufacturing#readme"
}
