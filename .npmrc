# npm 国内镜像源配置 - 使用 npmmirror（原淘宝镜像）
# 所有 npm install 命令将自动使用此源，无需手动指定 -registry
registry=https://registry.npmmirror.com

# P1 安全修复：移除 strict-ssl=false。
# 禁用 HTTPS 证书验证会让 npm install 容易遭受中间人攻击（攻击者可注入恶意包）。
# npmmirror.com 本身支持有效 HTTPS 证书，无需禁用验证。
# 若企业代理网络有证书拦截问题，开发者应在用户级 ~/.npmrc 中单独配置，
# 不应污染项目级配置影响所有人和 CI 环境。
# strict-ssl=false  （已移除）

# 设置日志级别
loglevel=warn
