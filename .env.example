# ============================================================
# 灵境制造（上线版）环境变量模板
# ============================================================
# 使用说明：
#   1. 复制本文件为 .env  ：  cp .env.example .env  (Linux/Mac)
#                           或 copy .env.example .env (Windows)
#   2. 在 .env 中为下列带占位符的变量填入真实值（密码建议使用密码管理器生成的高强度随机串）
#   3. .env 文件已被 .gitignore 忽略，请勿提交到 Git 仓库
#
# 安全要求：
#   - POSTGRES_PASSWORD   至少 16 位，包含大小写字母、数字、特殊字符
#   - GF_SECURITY_ADMIN_PASSWORD  至少 12 位，首次启动后请立即修改
#   - REDIS_PASSWORD      必填（docker-compose 已强制启用 requirepass），至少 16 位
#   - DATABASE_URL 中的密码需与 POSTGRES_PASSWORD 保持一致
#   - REDIS_URL 中的密码需与 REDIS_PASSWORD 保持一致
# ============================================================

# -------------------- 应用通用配置 --------------------
# 运行环境：development | staging | production | testing
# 注意：config.py 实际读取 ENVIRONMENT 变量（见下方"环境配置"小节），
#       APP_ENV 仅为 docker-compose 向后兼容保留，Python 应用不读取此变量。
APP_ENV=production

# API 服务端口（容器内）
# 注意：config.py 实际读取 SERVER_PORT 变量（见下方"服务器配置"小节），
#       PORT 仅为 docker-compose 向后兼容保留，Python 应用不读取此变量。
PORT=8765

# -------------------- PostgreSQL 数据库 --------------------
# 数据库用户名
POSTGRES_USER=lnn

# 数据库密码（必填，修改此处后请同步修改下方 DATABASE_URL 中的密码段）
# P0-14 修复：留空会导致 docker-compose 启动报错（POSTGRES_PASSWORD is required）。
# 请在此填入至少 16 位的强密码（大小写字母+数字+特殊字符），可用：
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=PLEASE_CHANGE_ME_to_a_strong_password

# 数据库名称
POSTGRES_DB=lnn_db

# 应用连接数据库的完整 URL（密码段必须与 POSTGRES_PASSWORD 一致）
# 格式：postgresql://<user>:<password>@<host>:<port>/<dbname>
# 注意：请将下方 CHANGE_ME 替换为与 POSTGRES_PASSWORD 完全一致的密码
DATABASE_URL=postgresql://lnn:PLEASE_CHANGE_ME@postgres:5432/lnn_db

# -------------------- 数据库连接池配置 --------------------
# 说明：以下变量由 app/database/connection.py 的 DatabaseConfig 读取，
#       与异步引擎及同步引擎（sync_session.py）共享。SQLite 自动忽略 pool_size/max_overflow。
# SQLAlchemy 引擎使用的 DB URL（优先级高于 DATABASE_URL；留空则回退到 config.database.db_url）
DB_URL=

# 连接池常驻连接数（仅 PostgreSQL 生效）
DB_POOL_SIZE=15

# 连接池溢出上限（仅 PostgreSQL 生效）
DB_MAX_OVERFLOW=10

# 获取连接超时（秒，仅 PostgreSQL 生效）
DB_POOL_TIMEOUT=30

# 连接回收周期（秒，仅 PostgreSQL 生效，避免数据库端主动断连）
DB_POOL_RECYCLE=3600

# 是否打印 SQL 日志（生产环境必须为 false）
DB_ECHO=false

# -------------------- Redis 缓存 --------------------
# Redis 访问密码（必填，docker-compose 已强制启用 requirepass；至少 16 位强密码）
# P0-14 修复：留空会导致 docker-compose 启动报错（REDIS_PASSWORD is required）。
# 请在此填入至少 16 位的强密码，可用：
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=PLEASE_CHANGE_ME_to_a_strong_redis_password

# 应用连接 Redis 的 URL（密码段必须与 REDIS_PASSWORD 一致）
# 格式：redis://:your_password@redis:6379/0
# 注意：请将下方 CHANGE_ME 替换为与 REDIS_PASSWORD 完全一致的密码
REDIS_URL=redis://:PLEASE_CHANGE_ME@redis:6379/0

# -------------------- Grafana 监控 --------------------
# Grafana 管理员密码（首次登录后请立即修改；至少 12 位）
# P0-14 修复：留空会导致 docker-compose 启动报错（GF_SECURITY_ADMIN_PASSWORD is required）。
GF_SECURITY_ADMIN_PASSWORD=PLEASE_CHANGE_ME_grafana

# Grafana 管理员用户名
GF_SECURITY_ADMIN_USER=admin

# -------------------- TDengine 时序数据库 --------------------
# 应用连接 TDengine 的 URL（使用 native 协议，端口 6030）
# 容器内推荐格式：taos://root:<your_password>@tdengine:6030
# 本地开发格式：  taos://root:<your_password>@localhost:6030
# 注意：密码段必须与下方 TDENGINE_PASSWORD 保持一致
# P1-5 修复：容器内 hostname 为 lnn-tdengine（见 docker-compose.yml），不是 tdengine。
# 以下 URL 同时兼容本地开发（localhost）和容器内（lnn-tdengine）两种场景。
TDENGINE_URL=taos://root:PLEASE_CHANGE_ME@lnn-tdengine:6030

# TDengine 数据库名（不存在时自动创建）
TDENGINE_DB=lnn_tsdb

# TDengine 用户名
TDENGINE_USER=root

# TDengine 密码（必填，请勿使用默认值）
# P0-14 修复：留空时应用将无法连接 TDengine；请填入与 taosd 容器一致的真实密码
TDENGINE_PASSWORD=PLEASE_CHANGE_ME_tdengine

# TDengine 连接超时（秒）
TDENGINE_CONNECT_TIMEOUT=10

# TDengine 健康检查端点（容器内为 taos 服务的 REST API）
TDENGINE_HEALTH_URL=http://lnn-tdengine:6041/api/health

# -------------------- 认证与安全 --------------------
# JWT 密钥（必填，至少 32 字符，使用以下命令生成）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 修复 [B32]：config.security.jwt_secret 与 app/auth/security.py 均读取此变量，
# 实际密钥验证（长度、随机性）由 app/auth/security.py 的 _validate_and_get_secret() 负责。
LNN_JWT_SECRET=

# 是否启用 JWT 认证（默认 true）
# 由 config.security.jwt_auth_enabled 读取，控制 UnifiedAuthMiddleware 是否校验 JWT。
LNN_JWT_AUTH_ENABLED=true

# LNN 令牌（可选，用于服务间认证）
# 优先级：环境变量 > .lnn_token 文件 > 自动生成（仅开发）
# 由 config.token.token 管理，留空时会在项目根目录生成 .lnn_token 文件。
LNN_TOKEN=

# 注册邀请码（可选，留空则注册功能关闭）
# 由 app/api/v1/auth.py 读取，控制用户注册开关。生产环境建议设置强随机值。
LNN_REGISTRATION_CODE=

# -------------------- 云服务 API --------------------
# 云端 LLM API Key（使用云服务时必填）
CLOUD_API_KEY=

# 云端 LLM Base URL
CLOUD_BASE_URL=https://api.openai.com/v1

# 云端 LLM 模型名称
CLOUD_MODEL=gpt-3.5-turbo

# -------------------- 镜像与模型配置 --------------------
# HuggingFace 镜像站（用于加速模型下载，默认使用中国镜像）
# 可选值：https://hf-mirror.com (中国) | https://huggingface.co (官方)
HF_ENDPOINT=https://hf-mirror.com

# Ollama 离线模型路径（可选）
# 如果设置，将优先从该路径加载模型，适用于无法访问外网的环境
# 可从 https://modelscope.cn 或 https://hf-mirror.com 手动下载模型
OLLAMA_MODEL_PATH=

# -----------------------------------------------------------------------------
# MES/ERP 系统集成配置（可选）
# -----------------------------------------------------------------------------
# 启用 MES 集成
MES_ENABLED=false

# MES 系统基础 URL
# MES_BASE_URL=https://mes.example.com

# MES API 认证密钥
# MES_API_KEY=your-mes-api-key

# MES 请求超时时间（秒）
MES_TIMEOUT=30.0

# -----------------------------------------------------------------------------
# 服务器配置
# -----------------------------------------------------------------------------
# 服务器绑定地址（默认 127.0.0.1，生产环境可能需要改为 0.0.0.0）
SERVER_HOST=127.0.0.1

# 服务器端口（默认 8765）
SERVER_PORT=8765

# 调试模式（生产环境必须为 false）
DEBUG=false

# -----------------------------------------------------------------------------
# AI 配置
# -----------------------------------------------------------------------------
# AI 模式：local | cloud | hybrid
AI_MODE=local

# Ollama 本地模型服务地址
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 默认模型
OLLAMA_MODEL=qwen2.5-coder:7b

# 本地模型名称（备用）
LOCAL_MODEL=qwen2.5:7b

# 云端 AI 提供商：openai | azure | anthropic
CLOUD_PROVIDER=openai

# 云端模型路由（用于复杂任务）
CLOUD_MODEL_ROUTER=gpt-4o

# AI 请求超时时间（秒）
AI_TIMEOUT=60

# AI 最大重试次数
AI_MAX_RETRIES=3

# 本地模型超时时间（秒）
LOCAL_TIMEOUT=30

# 回退阈值（本地模型置信度低于此值时切换到云端）
FALLBACK_THRESHOLD=3

# 微调自动触发（是否自动触发模型微调）
FINETUNE_AUTO_TRIGGER=false

# 微调最小样本数
FINETUNE_MIN_SAMPLES=50

# 微调间隔天数
FINETUNE_INTERVAL_DAYS=7

# -----------------------------------------------------------------------------
# LLM Provider 注册表配置
# -----------------------------------------------------------------------------
# 说明：以下变量由 app/ai/llm/provider_registry.py 读取。
# Provider 配置持久化在 SQLite（默认 python/data/llm_providers.db），
# API Key 使用 Fernet 对称加密存储。

# 自定义 Provider 注册表数据库路径（留空则使用默认 python/data/llm_providers.db）
LLM_PROVIDERS_DB=

# API Key 加密密钥（Fernet 兼容的 base64 urlsafe 32 字节）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时按以下优先级派生：
#   1. 本环境变量（生产环境强烈建议设置）
#   2. 项目令牌（.lnn_token 文件内容）→ SHA256 → Fernet key
#   3. 临时密钥（仅当前会话有效，重启后已加密 Key 无法解密，会记录警告）
LLM_PROVIDER_ENCRYPTION_KEY=

# 知识图谱 LLM 抽取默认 Provider（ollama | openai | azure | anthropic 等）
# 由 app/knowledge_graph/extractor/llm_extractor.py 读取
LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# 研究桥接（Research Bridge）特性开关
# -----------------------------------------------------------------------------
# 说明：以下变量由 app/research_bridge/feature_flags.py 与 app/api/v1/status.py 读取。
# Research Bridge 用于在影子模式下并行运行实验性研究代码路径，
# 不影响生产链路。生产环境建议保持关闭。

# 影子模式主开关（功能位）：true 启用影子执行路径
# 注意：status.py 中读取的 SHADOW_MODE_MASTER 仅为状态展示用，
#       实际功能开关为 RESEARCH_BRIDGE_SHADOW_MASTER。
RESEARCH_BRIDGE_SHADOW_MASTER=false

# 状态展示用别名（status 接口返回，不影响功能）
SHADOW_MODE_MASTER=0

# 研究功能总开关（状态展示用，0=关闭 / 1=开启）
ENABLE_RESEARCH=0

# -----------------------------------------------------------------------------
# RAG 检索增强配置
# -----------------------------------------------------------------------------
# 说明：以下变量由 app/rag/rag_retrieval.py 读取，控制 RAG 检索流水线各增强组件。
# 默认值已在代码中给出，此处显式声明以便生产环境调优。

# 是否启用查询改写（Query Rewrite）
ENABLE_QUERY_REWRITE=1

# 是否启用 HyDE（Hypothetical Document Embeddings）假设文档检索
ENABLE_HYDE=0

# 是否启用并行检索（多源并发）
ENABLE_PARALLEL_RETRIEVAL=1

# 并行检索工作线程数
PARALLEL_RETRIEVAL_WORKERS=4

# 是否启用结果缓存
ENABLE_RESULT_CACHE=1

# 结果缓存最大条目数
RESULT_CACHE_SIZE=200

# 是否启用混合检索（BM25 + Vector + RRF 融合）
ENABLE_HYBRID_SEARCH=1

# 是否启用 Cross-Encoding 重排序
ENABLE_RERANKER=1

# -----------------------------------------------------------------------------
# 仿真配置
# -----------------------------------------------------------------------------
# 体素尺寸（毫米）
LNN_SIM_VOXEL_SIZE=1.0

# 最大仿真存储数量
LNN_SIM_MAX_STORE=500

# 仿真存储过期时间（秒，默认 24 小时）
LNN_SIM_STORE_AGE=86400

# 碰撞检测边距（毫米）
LNN_SIM_COLLISION_MARGIN=0.5

# 批量处理大小
LNN_SIM_BATCH_SIZE=2000

# 安全 Z 高度（毫米）
LNN_SIM_SAFE_Z=10.0

# 空闲超时时间（秒，默认 30 分钟）
LNN_IDLE_TIMEOUT=1800

# 是否启用空闲自动关机中间件（P1-1 修复）
# - 桌面 sidecar 模式（sidecar_main.py 启动）：默认 false，用户随时回来使用，
#   避免冷启动开销（PyInstaller 解包 + FastAPI 初始化约 3-8 秒）
# - Docker / 独立服务模式：默认 true，节省云端资源
# 默认值：未设置时启用（true），sidecar_main.py 会显式覆盖为 false
LNN_IDLE_AUTO_SHUTDOWN=true

# -----------------------------------------------------------------------------
# 硬件档位配置（U-P0-2）
# -----------------------------------------------------------------------------
# 项目承诺全本地 LLM，但用户机器可能无 GPU/内存不足导致 Ollama 启动失败。
# 通过显式档位声明 + 轻量模式开关，让用户根据硬件条件选择合适的能力子集。
#
# 档位定义（与 docs/user-guide/安装指南.md 硬件配置表对齐）：
#   - minimal : 4 核 CPU / 8 GB RAM / 无 GPU（仅规则引擎 + 云端 API）
#   - standard: 8 核 CPU / 16 GB RAM / 可选 GPU（默认，支持本地小模型）
#   - high    : 8 核+ CPU / 32 GB RAM / NVIDIA GPU ≥ 6 GB（本地 7B-14B 模型）
#   - ultra   : 工作站级（本地 14B+ 模型 + GPU 训练）
#
# 注意：minimal 档位会自动派生 lightweight_mode=true 和 skip_ollama=true，
#       无需重复设置。非法值会回退到 standard 并记录警告。
LNN_HARDWARE_TIER=standard

# 轻量模式：跳过 Ollama 启动探测、强制云端 API 或规则引擎、限制 AI 并发数为 1
# 适用于老旧硬件 / 临时演示 / 仅需 CAM 核心功能的场景
LNN_LIGHTWEIGHT_MODE=false

# 显式跳过 Ollama 模块加载（即使安装了 ollama Python 包也不导入）
# 轻量模式或 minimal 档位下会自动启用；其他档位可独立设置以加速启动
LNN_SKIP_OLLAMA=false

# AI 推理最大并发数（轻量模式下强制为 1）
LNN_MAX_CONCURRENT_AI=2

# -----------------------------------------------------------------------------
# LNN 数据集缓存配置
# -----------------------------------------------------------------------------
# 由 app/ai/lnn/training/dataset_cache.py 读取。
# .pkl 缓存文件在反序列化前会用 HMAC-SHA256 校验签名，防止篡改触发 RCE。

# 磁盘缓存目录（默认 ~/.lingjing/cache/datasets/）
LNN_CACHE_DIR=

# HMAC 签名密钥（生产环境必须配置；留空则回退到进程级随机密钥）。
# 推荐使用 64 字符 hex 字符串（= 32 字节密钥），可通过以下命令生成：
#   python -c "import secrets; print(secrets.token_hex(32))"
# 或 base64 字符串（解码后 ≥ 32 字节）。
#
# 注意：
#   - 留空（默认）：每次进程重启生成新密钥，旧 .pkl 缓存因签名校验失败被清理，
#     安全但缓存命中率下降。适合开发环境。
#   - 配置固定值：磁盘缓存可在进程重启间复用，提升命中率。生产环境推荐。
#   - 密钥变更后所有旧缓存自动失效（HMAC 校验失败清理），属预期行为。
#   - 切勿将真实密钥提交到版本控制，通过 .env 或部署平台密钥管理注入。
LNN_CACHE_HMAC_KEY=

# -----------------------------------------------------------------------------
# CORS 跨域配置
# -----------------------------------------------------------------------------
# 灵境环境标识：development | production
# 与 cors_config.py 配合使用，决定 CORS 默认允许的来源集合。
# development: 默认允许 http://localhost:{3000,5173,8080}
# production:  默认空列表，必须通过 ALLOWED_ORIGINS 显式配置。
LINGJING_ENV=development

# 允许的源（逗号分隔，如 http://localhost:3000,https://app.example.com）
# 修复 [B30]：此变量为 cors_config.py 与 config.security.cors_origins 共同读取的
# 首选配置项，设置后覆盖 LINGJING_ENV 默认值。生产环境必须显式配置。
ALLOWED_ORIGINS=

# 向后兼容字段：与 ALLOWED_ORIGINS 等效，但优先级更低。
# 当 ALLOWED_ORIGINS 未设置时，config.security.cors_origins 会回退到此变量。
CORS_ORIGINS=

# 是否允许凭证（cookies, authorization headers）
CORS_ALLOW_CREDENTIALS=true

# 允许的正则表达式源（可选）
CORS_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# 速率限制
# -----------------------------------------------------------------------------
# 是否启用速率限制
RATE_LIMIT_ENABLED=true

# 每个窗口最大请求数
RATE_LIMIT_REQUESTS=100

# 时间窗口（秒）
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# 认证与权限
# -----------------------------------------------------------------------------
# 是否启用 LNN 认证
LNN_AUTH_ENABLED=true

# 是否强制执行权限检查
LNN_PERMISSION_ENFORCED=true

# 是否启用 Agent 认证
AGENT_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# 环境配置
# -----------------------------------------------------------------------------
# 运行环境：development | staging | production | testing
ENVIRONMENT=development

# 应用名称
APP_NAME=灵境制造

# 应用版本
APP_VERSION=2.7.0

# 离线模式（禁用所有外部网络请求）
OFFLINE_MODE=false

# -----------------------------------------------------------------------------
# 路径配置
# -----------------------------------------------------------------------------
# 备份目录
BACKUP_DIR=./backups

# SQLite 数据库路径
DB_PATH=./data/app.db

# 向量数据库路径
VECTOR_DB_PATH=./data/chroma_db

# 配置文件路径
CONFIG_PATH=./config.json

# GStack 目录
LNN_GSTACK_DIR=.lingjing/.gstack

# 项目根目录（默认由代码依据 __file__ 推导，仅在特殊部署路径下需要显式指定）
# 由 app/api/v1/dxf_pipeline.py 读取
LNN_PROJECT_ROOT=

# 主数据目录（默认 <project>/data）
# 由 app/api/v1/lnn/routes.py 与 app/middleware/input_validator.py 读取，
# 同时作为路径白名单根目录之一
LNN_DATA_DIR=

# 额外数据目录（多路径用 os.pathsep 分隔，Linux ":" / Windows ";"）
# 用于扩展 LNN 路由可访问的数据根目录集合
LNN_DATA_BASE_DIRS=

# 输出目录（可选，加入路径白名单）
LNN_OUTPUT_DIR=

# 上传目录（可选，加入路径白名单）
LNN_UPLOAD_DIR=

# 用户存储 JSON 文件路径（默认 .lnn_users.json）
# 由 app/models/user.py 读取，存放本地用户账号
LNN_USER_STORE_FILE=.lnn_users.json

# -----------------------------------------------------------------------------
# 任务系统配置
# -----------------------------------------------------------------------------
# 最大并发任务数
TASK_MAX_CONCURRENT=3

# 任务恢复策略：mark_failed | retry | ignore
TASK_RECOVERY_STRATEGY=mark_failed

# 最大任务历史记录数
TASK_MAX_HISTORY=10000

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LNN_LOG_LEVEL=INFO

# 日志格式
LNN_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志文件最大大小（字节，默认 50MB）
LNN_LOG_MAX_BYTES=52428800

# 日志备份数量
LNN_LOG_BACKUP_COUNT=5

# 日志保留天数
LNN_LOG_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 工艺规划阈值
# -----------------------------------------------------------------------------
# 默认粗糙度参数
LNN_PP_RA_DEFAULT=3.2

# 最小平面面积（mm²）
LNN_PP_MIN_PLANE_AREA=1.0

# 最小型腔尺寸（mm）
LNN_PP_MIN_CAVITY_DIM=0.5

# 最小凸台直径（mm）
LNN_PP_MIN_BOSS_DIAM=1.0

# 最小孔径（mm）
LNN_PP_MIN_HOLE_DIAM=0.5

# 钻头角度（度）
LNN_PP_DRILL_ANGLE=118.0

# GCode 程序号起始值
LNN_PP_GCODE_PROG_NUM=1000

# -----------------------------------------------------------------------------
# DNC 机床通信配置（可选）
# -----------------------------------------------------------------------------
# DNC 功能已内置，通过 API 动态配置机床连接
# 使用 /api/v1/dnc/machines 接口添加机床
# 支持 OPC UA 和 MTConnect 两种协议

# -----------------------------------------------------------------------------
# 阶段 7 CAM 软件二次校验配置（cam_validation 模块）
# -----------------------------------------------------------------------------
# 说明：以下变量由 app/config/__init__.py 的 CamValidationConfig 读取，
#       控制 G 代码生成后的二次校验流程（详见 ADR-018-CAM校验.md）。
#
# 工程边界（项目记忆硬约束）：
#   - 系统定位「工程师助手」，CAM 软件调用通过 subprocess + JSON 解耦
#   - 系统绝不直接接口 CNC 控制器，阶段 7 产物终止于「CAM 校验报告 JSON」
#   - 物理机床执行需持证操作员 + 导师签字 + 保险，阶段 7 不触及
#   - cam_validation_required 始终 True，allow_delete_succeeded 始终 False
#   - 当配置的 CAM 后端不可用时，CamAdapter 自动降级到 manual 后端（链路不中断）
#
# 模块总开关（桌面轻量档位下可关闭，但建议保持 True）
LNN_CAM_ENABLED=true

# CAM 校验报告输出目录（每个任务一个独立 workspace_dir）
LNN_CAM_OUTPUT_DIR=output/cam_validation

# 最大并发校验任务数（CAM 软件 subprocess 资源密集，桌面模式默认串行）
LNN_CAM_MAX_CONCURRENT=1

# 单任务超时（秒，CAM 软件二次校验耗时较长，默认 600s = 10 分钟）
LNN_CAM_TASK_TIMEOUT=600

# 任务历史保留时长（小时，默认 168h = 7 天，工程师审核需要时间）
LNN_CAM_TASK_RETENTION_HOURS=168

# 精度档位（仅用于 disclaimer 显示告知，实际精度由上游 mesh 决定）
# 可选值：coarse | standard | high | mesh_calibrated
LNN_CAM_PRECISION_TIER=mesh_calibrated

# 默认 CAM 后端（CamAdapter 策略模式分发）
# 可选值：
#   - internal_only : 仅内部预校验（秒级 AABB 包围盒，不调用外部软件）
#   - pycam         : subprocess 调用 PyCAM 包装器脚本（4 项基础检查，无需许可证）
#   - nx_open       : subprocess 调用 NX Open Python 脚本（需 NX 许可证）
#   - powermill     : subprocess 调用 PowerMill 宏（需 PowerMill 许可证）
#   - manual        : 生成校验清单 + 工程师回填（兜底，永不失败）
# 默认 internal_only：开发环境快速预筛；车间部署应切换为 nx_open / powermill
LNN_CAM_DEFAULT_BACKEND=internal_only

# NX Open Python 脚本路径（仅 default_cam_backend=nx_open 时使用）
# 指向项目内 cam_adapters 子目录的 autorun_gcode_check.py
# 示例：python/scripts/cam_adapters/nx_open/autorun_gcode_check.py
# 留空时 CamAdapter 自动降级到 manual 后端
LNN_CAM_NX_OPEN_EXECUTABLE=

# PowerMill 可执行文件路径（仅 default_cam_backend=powermill 时使用）
# 指向车间机器上 PowerMill 安装目录下的 pmill.exe
# 示例（Windows）：C:/Program Files/Autodesk/PowerMill 2024/bin/pmill.exe
# 留空时 CamAdapter 自动降级到 manual 后端
LNN_CAM_POWERMILL_EXECUTABLE=

# PyCAM 包装器脚本路径（仅 default_cam_backend=pycam 时使用）
# 指向项目自带的 python/scripts/cam_adapters/pycam/autorun_gcode_check.py
# 安装 PyCAM：pip install pycam
# 留空时 CamAdapter 自动降级到 manual 后端
LNN_CAM_PYCAM_EXECUTABLE=

# 是否允许 SUCCEEDED 状态任务删除（项目记忆硬约束：始终 False）
# SUCCEEDED 任务包含 cam_report.json，删除会破坏追溯链
# 此处强制 False，即使环境变量设为 true 也会被 __post_init__ 覆盖
LNN_CAM_ALLOW_DELETE_SUCCEEDED=false

# CAM 二次校验强制（项目记忆硬约束：始终 True，不可关闭）
# 阶段 6 G 代码必须经阶段 7 CAM 软件二次校验后方可上机床
# 系统绝不直接接口 CNC 控制器，CAM 校验报告 JSON 为阶段 7 最终产物
# 此处强制 True，即使环境变量设为 false 也会被 __post_init__ 覆盖
LNN_CAM_VALIDATION_REQUIRED=true
