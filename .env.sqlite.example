# ============================================================
# 灵境制造 - SQLite 单机部署环境变量模板
# ============================================================
# 用途：配合 docker-compose-sqlite.yml 使用，或作为桌面版 sidecar
#      模式的环境变量参考。所有数据落盘到本地 SQLite / ChromaDB，
#      无需 PostgreSQL / Redis / TDengine 等外部服务。
# 使用方法：cp .env.sqlite.example .env.sqlite
#          docker compose -f docker-compose-sqlite.yml --env-file .env.sqlite up -d
# 安全要求：
#   - LNN_JWT_SECRET          至少 32 字符，留空时启动会生成临时密钥（重启后失效）
#   - LNN_CACHE_HMAC_KEY      至少 32 字节，留空时每次进程重启生成新密钥（旧缓存失效）
#   - LLM_PROVIDER_ENCRYPTION_KEY  留空时按优先级派生（详见下方注释）
# ============================================================

# -------------------- 应用通用配置 --------------------
# 运行环境：development | staging | production | testing
# 注意：config.py 实际读取 ENVIRONMENT 变量，APP_ENV 仅为向后兼容保留。
APP_ENV=production
ENVIRONMENT=production

# 应用名称与版本
APP_NAME=灵境制造
APP_VERSION=2.7.0

# API 服务端口（容器内 / sidecar）
# 注意：config.py 实际读取 SERVER_PORT，PORT 仅为向后兼容保留。
# P0-7 修复：默认绑定 127.0.0.1（仅本机访问），避免误部署时对外暴露 API。
#         若需通过反向代理对外提供服务，显式设置为 0.0.0.0 并配合防火墙/TLS。
PORT=8765
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# 调试模式（生产环境必须为 false）
DEBUG=false

# 离线模式（禁用所有外部网络请求）
OFFLINE_MODE=false

# -------------------- AI 模型配置 --------------------
# AI 模式：local=本地 Ollama | cloud=云端 API | hybrid=混合
AI_MODE=local

# 本地 Ollama 配置
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LOCAL_MODEL=qwen2.5:7b

# Ollama 离线模型路径（可选，无法访问外网时从此路径加载）
OLLAMA_MODEL_PATH=

# 云端 API 配置（AI_MODE=cloud 或 hybrid 时需要）
CLOUD_API_KEY=
CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_MODEL=qwen-plus

# 云端 AI 提供商：openai | azure | anthropic
CLOUD_PROVIDER=openai

# 云端模型路由（用于复杂任务）
CLOUD_MODEL_ROUTER=gpt-4o

# AI 请求超时（秒）
AI_TIMEOUT=60
AI_MAX_RETRIES=3
LOCAL_TIMEOUT=30
FALLBACK_THRESHOLD=3

# -------------------- 硬件档位配置 --------------------
# 档位定义：minimal | standard | high | ultra
#   - minimal : 4 核 CPU / 8 GB RAM / 无 GPU（仅规则引擎 + 云端 API）
#   - standard: 8 核 CPU / 16 GB RAM / 可选 GPU（默认）
#   - high    : 8 核+ CPU / 32 GB RAM / NVIDIA GPU ≥ 6 GB
#   - ultra   : 工作站级（本地 14B+ 模型 + GPU 训练）
LNN_HARDWARE_TIER=standard

# 轻量模式：跳过 Ollama 启动探测、限制 AI 并发数为 1
LNN_LIGHTWEIGHT_MODE=false

# 显式跳过 Ollama 模块加载
LNN_SKIP_OLLAMA=false

# AI 推理最大并发数（轻量模式下强制为 1）
LNN_MAX_CONCURRENT_AI=2

# -------------------- 认证与安全 --------------------
# JWT 密钥（生产环境务必修改为随机长字符串，至少 32 字符）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：留空时应用启动会自动生成随机密钥（见 start_server.py / sidecar_main.py），
# 生成的密钥仅对当前进程有效，重启后会变化（已签发的 token 将失效）。
LNN_JWT_SECRET=

# 是否启用 JWT 认证（默认 true）
LNN_JWT_AUTH_ENABLED=true

# 是否启用 LNN 认证
LNN_AUTH_ENABLED=true

# 是否强制执行权限检查
LNN_PERMISSION_ENFORCED=true

# 是否启用 Agent 认证
AGENT_AUTH_ENABLED=true

# LNN 令牌（可选，服务间认证）
# 优先级：环境变量 > .lnn_token 文件 > 自动生成（仅开发）
LNN_TOKEN=

# 注册邀请码（可选，留空则注册功能关闭）
LNN_REGISTRATION_CODE=

# 用户存储 JSON 文件路径（默认 .lnn_users.json）
LNN_USER_STORE_FILE=.lnn_users.json

# -------------------- LLM Provider 注册表 --------------------
# Provider 配置持久化在 SQLite（默认 python/data/llm_providers.db）
# API Key 使用 Fernet 对称加密存储

# 自定义 Provider 注册表数据库路径（留空则使用默认路径）
LLM_PROVIDERS_DB=

# API Key 加密密钥（Fernet 兼容的 base64 urlsafe 32 字节）
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时按优先级派生：
#   1. 本环境变量（生产环境强烈建议设置）
#   2. 项目令牌（.lnn_token 文件内容）→ SHA256 → Fernet key
#   3. 临时密钥（仅当前会话有效，重启后已加密 Key 无法解密）
LLM_PROVIDER_ENCRYPTION_KEY=

# 知识图谱 LLM 抽取默认 Provider
LLM_PROVIDER=ollama

# -------------------- 路径配置 --------------------
# SQLite 数据库路径
DB_PATH=./data/app.db

# 向量数据库路径（ChromaDB）
VECTOR_DB_PATH=./data/chroma_db

# 备份目录
BACKUP_DIR=./backups

# 配置文件路径
CONFIG_PATH=./config.json

# GStack 目录
LNN_GSTACK_DIR=.lingjing/.gstack

# 项目根目录（默认由代码依据 __file__ 推导）
LNN_PROJECT_ROOT=

# 主数据目录（默认 <project>/data）
LNN_DATA_DIR=

# 额外数据目录（多路径用 os.pathsep 分隔）
LNN_DATA_BASE_DIRS=

# 输出目录（可选，加入路径白名单）
LNN_OUTPUT_DIR=

# 上传目录（可选，加入路径白名单）
LNN_UPLOAD_DIR=

# CAD 任务数据库
CAD_DB_PATH=cad_tasks.db

# -------------------- 仿真配置 --------------------
# 体素尺寸（毫米）
LNN_SIM_VOXEL_SIZE=1.0

# 最大仿真存储数量
LNN_SIM_MAX_STORE=500

# 仿真存储过期时间（秒，默认 24 小时）
LNN_SIM_STORE_AGE=86400

# 碰撞检测边距（毫米）
LNN_SIM_COLLISION_MARGIN=0.5

# 批量处理大小
LNN_SIM_BATCH_SIZE=2000

# 安全 Z 高度（毫米）
LNN_SIM_SAFE_Z=10.0

# 空闲超时时间（秒，默认 30 分钟）
LNN_IDLE_TIMEOUT=1800

# 是否启用空闲自动关机中间件
# - 桌面 sidecar 模式：默认 false（避免冷启动开销）
# - Docker / 独立服务模式：默认 true（节省资源）
LNN_IDLE_AUTO_SHUTDOWN=true

# -------------------- LNN 数据集缓存 --------------------
# 磁盘缓存目录（默认 ~/.lingjing/cache/datasets/）
LNN_CACHE_DIR=

# HMAC 签名密钥（生产环境必须配置；留空则回退到进程级随机密钥）
# 推荐使用 64 字符 hex 字符串：python -c "import secrets; print(secrets.token_hex(32))"
LNN_CACHE_HMAC_KEY=

# -------------------- CORS 跨域配置 --------------------
# 灵境环境标识：development | production
LINGJING_ENV=production

# 允许的源（逗号分隔）
# 修复 [B30]：此变量为 cors_config.py 与 config.security.cors_origins 共同读取的首选项
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:8765

# 向后兼容字段（ALLOWED_ORIGINS 优先级更高）
CORS_ORIGINS=http://localhost:1420,http://localhost:8765

# 是否允许凭证
CORS_ALLOW_CREDENTIALS=true

# 允许的正则表达式源（可选）
CORS_ORIGIN_REGEX=

# -------------------- 速率限制 --------------------
# 是否启用速率限制
RATE_LIMIT_ENABLED=true

# 每个窗口最大请求数
RATE_LIMIT_REQUESTS=100

# 时间窗口（秒）
RATE_LIMIT_WINDOW=60

# -------------------- 任务系统 --------------------
# 最大并发任务数
TASK_MAX_CONCURRENT=3

# 任务恢复策略：mark_failed | retry | ignore
TASK_RECOVERY_STRATEGY=mark_failed

# 最大任务历史记录数
TASK_MAX_HISTORY=10000

# -------------------- 日志配置 --------------------
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL
LNN_LOG_LEVEL=INFO

# 日志格式
LNN_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志文件最大大小（字节，默认 50MB）
LNN_LOG_MAX_BYTES=52428800

# 日志备份数量
LNN_LOG_BACKUP_COUNT=5

# 日志保留天数
LNN_LOG_RETENTION_DAYS=30

# -------------------- RAG 检索增强 --------------------
# 是否启用查询改写
ENABLE_QUERY_REWRITE=1

# 是否启用 HyDE
ENABLE_HYDE=0

# 是否启用并行检索
ENABLE_PARALLEL_RETRIEVAL=1

# 并行检索工作线程数
PARALLEL_RETRIEVAL_WORKERS=4

# 是否启用结果缓存
ENABLE_RESULT_CACHE=1

# 结果缓存最大条目数
RESULT_CACHE_SIZE=200

# 是否启用混合检索（BM25 + Vector + RRF）
ENABLE_HYBRID_SEARCH=1

# 是否启用 Cross-Encoding 重排序
ENABLE_RERANKER=1

# -------------------- 工艺规划阈值 --------------------
LNN_PP_RA_DEFAULT=3.2
LNN_PP_MIN_PLANE_AREA=1.0
LNN_PP_MIN_CAVITY_DIM=0.5
LNN_PP_MIN_BOSS_DIAM=1.0
LNN_PP_MIN_HOLE_DIAM=0.5
LNN_PP_DRILL_ANGLE=118.0
LNN_PP_GCODE_PROG_NUM=1000

# -------------------- 研究桥接（可选） --------------------
# 影子模式主开关（生产环境建议关闭）
RESEARCH_BRIDGE_SHADOW_MASTER=false
SHADOW_MODE_MASTER=0
ENABLE_RESEARCH=0

# -------------------- 镜像与模型配置 --------------------
# HuggingFace 镜像站（用于加速模型下载）
HF_ENDPOINT=https://hf-mirror.com

# -------------------- MES/ERP 集成（可选） --------------------
MES_ENABLED=false
MES_TIMEOUT=30.0

# -------------------- 阶段 7 CAM 软件二次校验（cam_validation） --------------------
# 说明：详见 ADR-018-CAM校验.md。系统绝不直接接口 CNC 控制器，
#       CAM 软件调用通过 subprocess + JSON 解耦，阶段 7 产物终止于
#       「CAM 校验报告 JSON」，物理机床执行需持证操作员 + 导师签字 + 保险。
#       当配置的 CAM 后端不可用时，CamAdapter 自动降级到 manual 后端。
#
# 模块总开关
LNN_CAM_ENABLED=true

# CAM 校验报告输出目录
LNN_CAM_OUTPUT_DIR=output/cam_validation

# 最大并发校验任务数（桌面模式默认串行）
LNN_CAM_MAX_CONCURRENT=1

# 单任务超时（秒）
LNN_CAM_TASK_TIMEOUT=600

# 任务历史保留时长（小时）
LNN_CAM_TASK_RETENTION_HOURS=168

# 精度档位（仅 disclaimer 显示告知）
LNN_CAM_PRECISION_TIER=mesh_calibrated

# 默认 CAM 后端：internal_only | pycam | nx_open | powermill | manual
# 桌面 sidecar 模式默认 internal_only（秒级预校验，不依赖外部 CAM 软件）
# 车间部署切换为 nx_open / powermill 时需配置下方对应路径
LNN_CAM_DEFAULT_BACKEND=internal_only

# NX Open Python 脚本路径（仅 default_cam_backend=nx_open 时使用）
# 示例：python/scripts/cam_adapters/nx_open/autorun_gcode_check.py
LNN_CAM_NX_OPEN_EXECUTABLE=

# PowerMill 可执行文件路径（仅 default_cam_backend=powermill 时使用）
# 示例：C:/Program Files/Autodesk/PowerMill 2024/bin/pmill.exe
LNN_CAM_POWERMILL_EXECUTABLE=

# PyCAM 包装器脚本路径（仅 default_cam_backend=pycam 时使用）
# 指向项目自带的 python/scripts/cam_adapters/pycam/autorun_gcode_check.py
# 安装：pip install pycam
LNN_CAM_PYCAM_EXECUTABLE=

# 项目记忆硬约束：以下两项始终强制，环境变量设为反向值会被 __post_init__ 覆盖
LNN_CAM_ALLOW_DELETE_SUCCEEDED=false
LNN_CAM_VALIDATION_REQUIRED=true
